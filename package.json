{
  "name": "cc-benefit-tracker",
  "version": "1.0.0",
  "description": "Credit Card & Loyalty Benefit Tracker — desktop app for tracking credit card and status benefits, credits, and usage",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && node scripts/clean-tsbuildinfo.js && tsc -p tsconfig.node.json && node scripts/copy-electron-assets.js",
    "electron:build": "npm run build && electron-builder --config electron-builder.config.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "41.5.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vitest": "^1.3.1",
    "wait-on": "^7.2.0"
  },
  "author": "Ann Dunkin"
}
